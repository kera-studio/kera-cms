{
  "kind": "collectionType",
  "collectionName": "customers",
  "info": {
    "singularName": "customer",
    "pluralName": "customers",
    "displayName": "z_Read only – Customer",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "import-export-entries": {
      "idField": "user_key"
    }
  },
  "attributes": {
    "user_key": {
      "type": "string",
      "unique": true
    },
    "email": {
      "type": "email"
    },
    "course_ownerships": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-ownership.course-ownership",
      "mappedBy": "customer"
    },
    "branch": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "brno-stankova",
        "praha-veletrzni",
        "kera-mini"
      ]
    }
  }
}
