{
  "kind": "collectionType",
  "collectionName": "studios",
  "info": {
    "singularName": "studio",
    "pluralName": "studios",
    "displayName": "Studios",
    "description": "Physical studio location."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "branch": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "brno-stankova",
        "praha-veletrzni",
        "kera-mini"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Leader": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::employee.employee",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Employees": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::employee.employee",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Address": {
      "type": "component",
      "component": "studio.address",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "StudioOpeningHours": {
      "type": "component",
      "component": "studio.opening-hours",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "CustomerSupportOpeningHours": {
      "type": "component",
      "component": "studio.opening-hours",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Order": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
