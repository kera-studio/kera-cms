{
  "kind": "collectionType",
  "collectionName": "workshop_activities",
  "info": {
    "singularName": "workshop-activity",
    "pluralName": "workshop-activities",
    "displayName": "Activity – Workshop",
    "description": "A workshop activity scheduled on one or more dates."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "base": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "activity.base",
      "repeatable": false,
      "required": true
    },
    "content": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "content.richtext",
        "content.media-row",
        "content.video",
        "content.premade-products"
      ]
    },
    "dates": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "component": "shared.event-date",
      "repeatable": true
    },
    "studio": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::studio.studio",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
