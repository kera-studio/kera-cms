{
  "kind": "collectionType",
  "collectionName": "auth_tokens",
  "info": {
    "singularName": "auth-token",
    "pluralName": "auth-tokens",
    "displayName": "z_Read only – Auth token"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "email": {
      "type": "string",
      "required": true
    },
    "branch": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "brno-stankova",
        "praha-veletrzni"
      ]
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "user-activation",
        "forgot-password"
      ]
    },
    "token": {
      "type": "string",
      "required": true
    }
  }
}
