{
  "kind": "collectionType",
  "collectionName": "group_activities",
  "info": {
    "singularName": "group-activity",
    "pluralName": "group-activities",
    "displayName": "Activity – Group",
    "description": "An activity made up of multiple group lessons."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "targetField": "title"
    },
    "base": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "activity.base",
      "repeatable": false,
      "required": true
    },
    "content": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "content.richtext",
        "content.media-row",
        "content.video",
        "content.premade-products"
      ]
    },
    "branches": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "options": [
        "brno-stankova",
        "praha-veletrzni",
        "kera-mini",
        "custom"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "occasions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::group-activity-occasion.group-activity-occasion",
      "mappedBy": "groupActivities",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
