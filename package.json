{
  "name": "kera-cms",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "transfer:pull": "source .env && pnpm strapi transfer --from $REMOTE_URL --from-token $TRANSFER_TOKEN",
    "transfer:push": "source .env && pnpm strapi transfer --to $REMOTE_URL --to-token $TRANSFER_TOKEN --exclude files"
  },
  "dependencies": {
    "@avorati/strapi-provider-upload-minio": "^1.7.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@strapi/design-system": "^2.2.0",
    "@strapi/plugin-cloud": "5.37.1",
    "@strapi/plugin-documentation": "5.37.1",
    "@strapi/plugin-users-permissions": "5.37.1",
    "@strapi/strapi": "5.37.1",
    "better-sqlite3": "^12.6.2",
    "pg": "8.8.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "strapi-advanced-uuid": "^2.1.1",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "d425a8d0-5849-427f-9e60-2c107e8ce472",
    "installId": "a2b28e2df5c4b2f0851e3487a202c4dd1d0214919502bf39b4e1777ddef2b29b"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "core-js-pure",
      "esbuild",
      "sharp"
    ]
  }
}
